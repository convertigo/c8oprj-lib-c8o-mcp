            "kind": "text",
            "text": "Collect project metadata for JSON output"
          }]
        },
        {
          "kind": "element",
          "tag": "expression",
          "children": [{
            "kind": "text",
            "text": "var Engine = Packages.com.twinsoft.convertigo.engine.Engine;\nvar JSONObject = Packages.org.codehaus.jettison.json.JSONObject;\nvar DateFormat = Packages.java.text.DateFormat;\nvar Date = Packages.java.util.Date;\nvar File = Packages.java.io.File;\nvar Locale = Packages.java.util.Locale;\n\nvar filterRaw = filter == null ? '' : String(filter);\nvar filterText = filterRaw.trim();\nvar hasFilter = filterText.length > 0;\nif (hasFilter) {\n  filterText = filterText.toLowerCase();\n}\n\nvar defaultLimit = 10;\nvar maxLimit = 100;\nvar limitValue = defaultLimit;\nif (typeof limit !== 'undefined' && limit !== null) {\n  try {\n    var parsedLimit = parseInt(String(limit).trim(), 10);\n    if (!isNaN(parsedLimit)) {\n      limitValue = parsedLimit;\n    }\n  } catch(ignoreLimit) {}\n}\nif (limitValue < 1) { limitValue = defaultLimit; }\nif (limitValue > maxLimit) { limitValue = maxLimit; }\n\nvar cursorRaw = typeof _nextCursor === 'undefined' || _nextCursor == null ? '' : String(_nextCursor).trim();\nvar startIndex = 0;\nif (cursorRaw.length > 0) {\n  try {\n    var parsedCursor = parseInt(cursorRaw, 10);\n    if (!isNaN(parsedCursor) && parsedCursor >= 0) {\n      startIndex = parsedCursor;\n    }\n  } catch(ignoreCursor) {}\n}\n\nvar locale = Locale.getDefault();\nvar df = DateFormat.getDateTimeInstance(DateFormat.SHORT, DateFormat.SHORT, locale);\nvar dbom = Engine.theApp.databaseObjectsManager;\nvar names = dbom.getAllProjectNamesList();\nvar projectsList = new java.util.ArrayList();\nvar totalProjects = 0;\n\nfor (var i = 0; i < names.size(); i++) {\n  var projectName = names.get(i);\n  try {\n    var project = dbom.getOriginalProjectByName(projectName);\n    if (project == null) { continue; }\n    var comment = project.getComment();\n    if (comment == null) { comment = ''; }\n    try {\n      var json = new JSONObject(comment);\n      var localeKey = locale.getLanguage();\n      var block = null;\n      if (json.has(localeKey)) { block = json.getJSONObject(localeKey); }\n      else {\n        var keys = json.keys();\n        if (keys.hasNext()) {\n          block = json.getJSONObject(keys.next().toString());\n        }\n      }\n      if (block != null) {\n        comment = project.getName();\n        if (block.has('displayName')) { comment = block.getString('displayName'); }\n        if (block.has('comment')) { comment = comment + ': ' + block.getString('comment'); }\n      }\n    } catch(ignore) {}\n    comment = comment.replaceAll('<.*?>', '');\n    if (comment.length() > 200) { comment = comment.substring(0, 197) + '...'; }\n\n    if (hasFilter) {\n      var nameLower = projectName != null ? projectName.toLowerCase() : '';\n      var commentLower = comment != null ? comment.toLowerCase() : '';\n      if (nameLower.indexOf(filterText) == -1 && commentLower.indexOf(filterText) == -1) {\n        continue;\n      }\n    }\n\n    var carFile = new File(Engine.projectDir(projectName) + '.car');\n    var deployTs = carFile.exists() ? carFile.lastModified() : -1;\n    var deployDate = deployTs > 0 ? df.format(new Date(deployTs)) : 'n\/a';\n    var exportedInfo = project.getInfoForProperty('exported', df, locale);\n    var exportedTs = project.getExportTime();\n    var projectMap = new java.util.LinkedHashMap();\n    projectMap.put('name', projectName);\n    projectMap.put('comment', comment);\n    projectMap.put('version', project.getVersion());\n    projectMap.put('exported', exportedInfo != null ? String(exportedInfo) : 'n\/a');\n    projectMap.put('deployDate', deployDate);\n\n    projectsList.add(projectMap);\n    totalProjects++;\n  } catch(e) {\n    log.warn('[MCP] AdminListProjects error for project ' + projectName + ' ' + e);\n  }\n}\n\nvar effectiveStart = startIndex;\nif (effectiveStart < 0) { effectiveStart = 0; }\nif (effectiveStart > totalProjects) { effectiveStart = totalProjects; }\nvar endIndex = effectiveStart + limitValue;\nif (endIndex > totalProjects) { endIndex = totalProjects; }\nvar pagedList = new java.util.ArrayList();\nfor (var idx = effectiveStart; idx < endIndex; idx++) {\n  pagedList.add(projectsList.get(idx));\n}\nvar returnedCount = pagedList.size();\nvar hasMorePages = endIndex < totalProjects;\nvar nextCursorValue = hasMorePages ? String(endIndex) : '';\n\nvar summary = new java.util.LinkedHashMap();\nsummary.put('total', java.lang.Integer.valueOf(totalProjects));\nsummary.put('filter', hasFilter ? filterRaw : '');\nsummary.put('timestamp', java.lang.Long.valueOf(java.lang.System.currentTimeMillis()));\nsummary.put('startIndex', java.lang.Integer.valueOf(effectiveStart));\nsummary.put('limit', java.lang.Integer.valueOf(limitValue));\nsummary.put('returned', java.lang.Integer.valueOf(returnedCount));\nsummary.put('hasMore', java.lang.Boolean.valueOf(hasMorePages));\nsummary.put('nextCursor', nextCursorValue);\nsummary.put('cursorInput', cursorRaw);\n\nprojectsList = pagedList;\nsummary = summary;\nnextCursorToken = nextCursorValue;"
          }]
        }
      ]
    },
