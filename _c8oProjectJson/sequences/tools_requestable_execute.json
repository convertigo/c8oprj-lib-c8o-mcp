            "text": "var errors = [];\nvar startedAt = java.lang.System.currentTimeMillis();\nvar requestText = C8O.util.toTrimmedString(requestable);\nif (!requestText.length) {\n    throw new Error('requestable is required');\n}\nvar parts = requestText.split('.');\nif (parts.length < 2) {\n    throw new Error('requestable must be <project>[.<connector>].<requestable>');\n}\nvar projectName = parts[0];\nvar targetConnector = null;\nvar targetName = null;\nvar isSequence = false;\nif (parts.length == 2) {\n    isSequence = true;\n    targetName = parts[1];\n} else {\n    targetConnector = parts[1];\n    targetName = parts.slice(2).join('.');\n}\nif (!targetName || !targetName.length) {\n    throw new Error('requestable name is missing');\n}\nvar variablesObject = C8O.util.parseObjectInput(variables, {\n    label: 'variables',\n    allowEmpty: true\n});\nvar recordSchemaFlag = false;\ntry {\n    recordSchemaFlag = C8O.util.toBoolean ? C8O.util.toBoolean(recordSchema, false) : (String(recordSchema || '').toLowerCase() === 'true');\n} catch (_ignoreRs) {}\nvar includeLogsFlag = false;\ntry {\n    includeLogsFlag = C8O.util.toBoolean ? C8O.util.toBoolean(includeLogs, false) : (String(includeLogs || '').toLowerCase() === 'true');\n} catch (_ignoreIl) {}\nexecutionPlan = {\n    requestable: requestText,\n    project: projectName,\n    connector: targetConnector,\n    name: targetName,\n    isSequence: isSequence,\n    variables: variablesObject,\n    recordSchema: recordSchemaFlag,\n    includeLogs: includeLogsFlag,\n    startedAt: startedAt\n};"
