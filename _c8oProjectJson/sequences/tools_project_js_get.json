      "bean": {
        "selector": "yaml_key",
        "raw": "InitContext [steps.SimpleStep-1762350567241]",
        "name": "InitContext",
        "className": "steps.SimpleStep",
        "priority": 1762350567241
      },
      "children": [
        {
          "kind": "element",
          "tag": "comment",
          "children": [{
            "kind": "text",
            "text": "Validate input and load file content"
          }]
        },
        {
          "kind": "element",
          "tag": "expression",
          "children": [{
            "kind": "text",
            "text": "var project = context.project;\nif (!project) { throw new Error(\"No project context\"); }\nvar jsDir = new java.io.File(project.getDirPath(), \"js\");\nvar filenameText = filename == null ? \"\" : String(filename).trim();\nif (!filenameText.length) { throw new Error(\"filename is required\"); }\nvar normalized = filenameText.replace(\/\\\\\/g, \"\/\");\nwhile (normalized.indexOf(\"\/\/\") >= 0) { normalized = normalized.replace(\"\/\/\", \"\/\"); }\nif (normalized.startsWith(\"\/\")) { normalized = normalized.substring(1); }\nrequestedName = normalized;\nvar baseFile = jsDir.getCanonicalFile();\nvar basePath = baseFile.toPath();\nvar targetFile = new java.io.File(baseFile, normalized).getCanonicalFile();\nvar targetPath = targetFile.toPath();\nif (!targetPath.startsWith(basePath)) { throw new Error(\"Invalid filename: \" + normalized); }\ndirectoryExists = jsDir.exists();\nfileExists = targetFile.exists();\nfileCanonicalPath = String(targetFile.getPath());\nfileRelativePath = basePath.relativize(targetPath).toString();\nresultTimestamp = java.lang.System.currentTimeMillis();\nif (fileExists) {\n  var bytes = java.nio.file.Files.readAllBytes(targetPath);\n  fileContent = new java.lang.String(bytes, java.nio.charset.StandardCharsets.UTF_8);\n  resultStatus = \"ok\";\n  resultMessage = \"File loaded\";\n  resultBytes = bytes.length;\n} else {\n  fileContent = \"\";\n  resultStatus = directoryExists ? \"missing\" : \"uninitialized\";\n  resultMessage = directoryExists ? \"File not found\" : \"js directory not created\";\n  resultBytes = 0;\n}"
          }]
        }
      ]
    },
