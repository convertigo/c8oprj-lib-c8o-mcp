        "kind": "element",
        "tag": "expression",
        "children": [{
          "kind": "text",
          "text": "function splitComment(text) {\n  if (!text) { return { title: \"\", description: \"\" }; }\n  var normalized = String(text).replace(\/\\r\\n?\/g, \"\\n\").trim();\n  if (normalized.length === 0) { return { title: \"\", description: \"\" }; }\n  var lines = normalized.split(\"\\n\");\n  var title = \"\";\n  var descriptionParts = [];\n  for (var i = 0; i < lines.length; i++) {\n    var line = lines[i].trim();\n    if (!title && line.length) {\n      title = line;\n    } else if (line.length) {\n      descriptionParts.push(line);\n    }\n  }\n  return { title: title, description: descriptionParts.join(\"\\n\") };\n}\n\nfunction sanitizeSlug(value) {\n  if (!value) { return \"\"; }\n  var slug = String(value).toLowerCase().replace(\/[^a-z0-9_-]+\/g, \"-\");\n  slug = slug.replace(\/-{2,}\/g, \"-\").replace(\/^-+|-+$\/g, \"\");\n  return slug;\n}\n\nfunction humanize(value) {\n  if (!value) { return \"\"; }\n  var text = String(value).replace(\/[-_]+\/g, \" \" ).trim();\n  if (!text.length) { return \"\"; }\n  return text.replace(\/\\w\\S*\/g, function(word) {\n    return word.charAt(0).toUpperCase() + word.substring(1).toLowerCase();\n  });\n}\n\nvar requestable = context.project.getSequenceByName(sequence);\nif (!requestable) { throw new Error(\"Sequence not found: \" + sequence); }\nvar lowerName = String(sequence).toLowerCase();\nif (!lowerName.startsWith(\"tools_\")) { throw new Error(\"Invalid tool sequence name: \" + sequence); }\nvar tokens = lowerName.split(\"_\");\nvar rawCategory = tokens.length > 1 ? tokens[1] : \"\";\nvar categorySlug = sanitizeSlug(rawCategory) || \"general\";\nvar rawSegments = tokens.slice(2);\nvar combinedRaw = rawSegments.join(\"-\");\nvar mainSlug = sanitizeSlug(combinedRaw) || \"tool\";\nvar toolName = categorySlug.length ? categorySlug + \"-\" + mainSlug : mainSlug;\nvar meta = splitComment(requestable.getComment());\nvar fallbackTitle = humanize(mainSlug) || humanize(sequence.replace(\/^tools_\/, \"\")) || \"Tool\";\nvar toolTitle = meta.title && meta.title.length ? meta.title : fallbackTitle;\nvar toolDescription = meta.description && meta.description.length ? meta.description : toolTitle;\ncategory = categorySlug;\ntool_slug = mainSlug;\ntool_name = toolName;\ntool_title = toolTitle;\ntool_description = toolDescription;"
        }]
      }]
    },
