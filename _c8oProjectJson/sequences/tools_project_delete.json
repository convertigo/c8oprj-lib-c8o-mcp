      "bean": {
        "selector": "yaml_key",
        "raw": "Init [steps.SimpleStep-1773102101002]",
        "name": "Init",
        "className": "steps.SimpleStep",
        "priority": 1773102101002
      },
      "children": [
        {
          "kind": "element",
          "tag": "comment",
          "children": [{
            "kind": "text",
            "text": "Resolve project and perform deletion"
          }]
        },
        {
          "kind": "element",
          "tag": "expression",
          "children": [{
            "kind": "text",
            "text": "var Engine = Packages.com.twinsoft.convertigo.engine.Engine;\nvar File = Packages.java.io.File;\n\nvar providedName = C8O.util.toTrimmedString(project);\nif (!providedName.length && context && context.project) {\n  providedName = String(context.project.getName());\n}\n\nvar deleteCarInput = (typeof deleteCar !== \"undefined\") ? deleteCar : true;\nvar deleteCarFlag = C8O.util.toBoolean(deleteCarInput, true) === true;\nvar errorEntries = [];\nvar foundBeforeDelete = false;\nvar deletedFlag = false;\nvar statusText = \"missing\";\nvar messageText = \"\";\n\nif (!providedName.length) {\n  messageText = \"Project name is required\";\n  errorEntries.push({ name: \"__delete__\", message: messageText });\n} else {\n  try {\n    foundBeforeDelete = Engine.theApp.databaseObjectsManager.existsProject(providedName);\n  } catch (_ignoredExistsBefore) {}\n  if (!foundBeforeDelete) {\n    messageText = \"Project not found: \" + providedName;\n  } else {\n    try {\n      if (deleteCarFlag) {\n        Engine.theApp.databaseObjectsManager.deleteProjectAndCar(providedName);\n      } else {\n        Engine.theApp.databaseObjectsManager.deleteProject(providedName, false, false);\n      }\n      try {\n        var ConvertigoPlugin = Packages.com.twinsoft.convertigo.eclipse.ConvertigoPlugin;\n        var plugin = ConvertigoPlugin != null && ConvertigoPlugin.getDefault ? ConvertigoPlugin.getDefault() : null;\n        if (plugin != null) {\n          plugin.deleteProjectPluginResource(true, providedName);\n        }\n      } catch (_ignoredStudioCleanup) {}\n      var stillExists = false;\n      try {\n        stillExists = Engine.theApp.databaseObjectsManager.existsProject(providedName);\n      } catch (_ignoredExistsAfter) {}\n      deletedFlag = !stillExists;\n      statusText = deletedFlag ? \"deleted\" : \"failed\";\n      if (!deletedFlag) {\n        messageText = \"Project still exists after deletion attempt\";\n        errorEntries.push({ name: \"delete\", message: messageText });\n      }\n    } catch (deleteError) {\n      statusText = \"failed\";\n      messageText = String(deleteError);\n      errorEntries.push({ name: \"delete\", message: messageText });\n    }\n  }\n}\n\nprojectDeleteProvided = providedName;\nprojectDeleteFound = foundBeforeDelete;\nprojectDeleteDeleted = deletedFlag;\nprojectDeleteDeleteCar = deleteCarFlag;\nprojectDeleteStatus = statusText;\nprojectDeleteMessage = messageText;\nprojectDeleteTimestamp = java.lang.System.currentTimeMillis();\nprojectDeleteErrors = errorEntries;\n"
          }]
        }
      ]
    },
