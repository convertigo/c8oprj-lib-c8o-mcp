          "children": [{
            "kind": "text",
            "text": "Resolve project and perform reload"
          }]
        },
        {
          "kind": "element",
          "tag": "expression",
          "children": [{
            "kind": "text",
            "text": "var providedName = C8O.util.toTrimmedString(project);\nif (!providedName.length && context && context.project) {\n  providedName = String(context.project.getName());\n}\n\nvar errorEntries = [];\nvar reloadResult;\nif (providedName.length) {\n  reloadResult = C8O.dbo.reloadProject(providedName, errorEntries);\n} else {\n  var missingMessage = \"Project name is required\";\n  errorEntries.push({ name: \"__reload__\", message: missingMessage });\n  reloadResult = { reloaded: false, message: missingMessage };\n}\n\nvar reloadedFlag = reloadResult.reloaded === true;\nvar statusText = reloadedFlag ? \"reloaded\" : (providedName.length ? \"failed\" : \"missing\");\n\nprojectReloadRequested = providedName;\nprojectReloadReloaded = reloadedFlag;\nprojectReloadMessage = reloadResult.message || \"\";\nprojectReloadTimestamp = java.lang.System.currentTimeMillis();\nprojectReloadErrors = errorEntries;\nprojectReloadStatus = statusText;\n"
          }]
        }
      ]
    },
