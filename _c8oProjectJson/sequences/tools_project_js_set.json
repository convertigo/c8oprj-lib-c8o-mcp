      "bean": {
        "selector": "yaml_key",
        "raw": "InitContext [steps.SimpleStep-1762350567267]",
        "name": "InitContext",
        "className": "steps.SimpleStep",
        "priority": 1762350567267
      },
      "children": [
        {
          "kind": "element",
          "tag": "comment",
          "children": [{
            "kind": "text",
            "text": "Validate input and persist file content"
          }]
        },
        {
          "kind": "element",
          "tag": "expression",
          "children": [{
            "kind": "text",
            "text": "var project = context.project;\nif (!project) { throw new Error(\"No project context\"); }\nvar jsDir = new java.io.File(project.getDirPath(), \"js\");\nvar filenameText = filename == null ? \"\" : String(filename).trim();\nif (!filenameText.length) { throw new Error(\"filename is required\"); }\nvar normalized = filenameText.replace(\/\\\\\/g, \"\/\");\nwhile (normalized.indexOf(\"\/\/\") >= 0) { normalized = normalized.replace(\"\/\/\", \"\/\"); }\nif (normalized.startsWith(\"\/\")) { normalized = normalized.substring(1); }\nrequestedName = normalized;\nvar baseFile = jsDir.getCanonicalFile();\nvar basePath = baseFile.toPath();\nvar targetFile = new java.io.File(baseFile, normalized).getCanonicalFile();\nvar targetPath = targetFile.toPath();\nif (!targetPath.startsWith(basePath)) { throw new Error(\"Invalid filename: \" + normalized); }\nvar parentDir = targetFile.getParentFile();\njava.nio.file.Files.createDirectories(parentDir.toPath());\nvar existed = targetFile.exists();\nvar textContent = content == null ? \"\" : String(content);\nvar bytes = new java.lang.String(textContent).getBytes(java.nio.charset.StandardCharsets.UTF_8);\njava.nio.file.Files.write(\n  targetPath,\n  bytes,\n  java.nio.file.StandardOpenOption.CREATE,\n  java.nio.file.StandardOpenOption.TRUNCATE_EXISTING,\n  java.nio.file.StandardOpenOption.WRITE\n);\nresultStatus = \"written\";\nresultMessage = existed ? \"File updated\" : \"File created\";\nresultCreated = !existed;\nresultBytes = bytes.length;\nresultTimestamp = java.lang.System.currentTimeMillis();\nfileCanonicalPath = String(targetFile.getPath());\nfileRelativePath = basePath.relativize(targetPath).toString();\nfileExists = true;\ndirectoryExists = true;\nfileContent = textContent;"
          }]
        }
      ]
    },
