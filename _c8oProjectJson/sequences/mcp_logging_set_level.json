            "text": "var logLevelInfo = { requested: \"\", normalized: \"\", applied: \"\", success: true, message: \"\" };\nvar parsedParams = {};\ntry { if (paramsJson && paramsJson.length) { parsedParams = JSON.parse(paramsJson); } } catch (e) { logLevelInfo.success = false; logLevelInfo.message = \"Invalid params JSON\"; }\nvar requested = \"\";\nif (parsedParams && typeof parsedParams.level === \"string\") { requested = parsedParams.level.trim(); }\nlogLevelInfo.requested = requested;\nvar allowed = { trace: \"TRACE\", debug: \"DEBUG\", info: \"INFO\", warn: \"WARN\", warning: \"WARN\", error: \"ERROR\" };\nvar normalized = \"\";\nif (requested && allowed[requested.toLowerCase()]) { normalized = allowed[requested.toLowerCase()]; } else if (!logLevelInfo.message) { logLevelInfo.message = requested ? \"Unsupported level (accepted: trace, debug, info, warn, error)\" : \"No level provided\"; logLevelInfo.success = false; }\nif (!normalized) { normalized = \"INFO\"; }\nlogLevelInfo.normalized = normalized;\nlogLevelInfo.applied = normalized;\nif (!logLevelInfo.message) { logLevelInfo.message = \"Logging level accepted\"; }"
          }]
        }
