      "children": [{
        "kind": "text",
        "text": "Force an NGX application source sync (reset + updateSourceFiles) for a target project\/qname."
      }]
    },
    {
      "kind": "element",
      "tag": "bean",
      "attributes": [{
        "name": "yaml_key",
        "value": "InitContext [steps.SimpleStep-1772122600001]"
      }],
      "bean": {
        "selector": "yaml_key",
        "raw": "InitContext [steps.SimpleStep-1772122600001]",
        "name": "InitContext",
        "className": "steps.SimpleStep",
        "priority": 1772122600001
      },
      "children": [
        {
          "kind": "element",
          "tag": "comment",
          "children": [{
            "kind": "text",
            "text": "Resolve target NGX application and trigger BuilderUtils update."
          }]
        },
        {
          "kind": "element",
          "tag": "expression",
          "children": [{
            "kind": "text",
            "text": "var Engine = Packages.com.twinsoft.convertigo.engine.Engine;\nvar BuilderUtils = Packages.com.twinsoft.convertigo.engine.admin.services.studio.ngxbuilder.BuilderUtils;\nvar ApplicationComponentClass = Packages.com.twinsoft.convertigo.beans.ngx.components.ApplicationComponent;\n\nvar providedQName = qname == null ? \"\" : String(qname).trim();\nvar providedProject = project == null ? \"\" : String(project).trim();\nif (!providedProject.length && context && context.project) {\n  providedProject = String(context.project.getName());\n}\n\nresultTimestamp = java.lang.System.currentTimeMillis();\nresultStudioMode = Engine.isStudioMode();\nresultRequestedQName = providedQName;\nresultRequestedProject = providedProject;\nresultProject = providedProject;\nresultAppQName = \"\";\nresultStatus = \"error\";\nresultMessage = \"\";\nresultError = \"\";\n\ntry {\n  if (!resultStudioMode) {\n    resultStatus = \"skipped\";\n    resultMessage = \"NGX source sync skipped: Convertigo Studio required\";\n  } else {\n    var target = null;\n    if (providedQName.length) {\n      try {\n        target = Engine.theApp.databaseObjectsManager.getDatabaseObjectByQName(providedQName);\n      } catch (_ignoreTargetLookup) {}\n      if (target == null) {\n        throw new Error(\"Database object not found: \" + providedQName);\n      }\n    }\n\n    var app = null;\n    if (target != null) {\n      if (target instanceof ApplicationComponentClass) {\n        app = target;\n      } else if (typeof target.getApplication === \"function\") {\n        app = target.getApplication();\n      }\n    }\n\n    if (app == null && providedProject.length) {\n      var projectRef = Engine.theApp.databaseObjectsManager.getOriginalProjectByName(providedProject);\n      if (projectRef == null) {\n        throw new Error(\"Project not found: \" + providedProject);\n      }\n      var mobileApplication = projectRef.getMobileApplication();\n      if (mobileApplication == null) {\n        throw new Error(\"Project has no mobile application: \" + providedProject);\n      }\n      app = mobileApplication.getApplicationComponent();\n    }\n\n    if (app == null) {\n      throw new Error(\"Unable to resolve NGX application from inputs\");\n    }\n    if (!(app instanceof ApplicationComponentClass)) {\n      throw new Error(\"Target application is not NGX: \" + String(app.getClass().getName()));\n    }\n\n    resultProject = String(app.getProject().getName());\n    resultAppQName = String(app.getQName());\n    BuilderUtils.dboUpdated(app);\n\n    resultStatus = \"ok\";\n    resultMessage = \"NGX application sources synchronized\";\n  }\n} catch (syncError) {\n  resultStatus = \"error\";\n  resultMessage = String(syncError);\n  resultError = String(syncError);\n}"
          }]
        }
      ]
