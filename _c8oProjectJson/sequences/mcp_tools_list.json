          "children": [{
            "kind": "text",
            "text": "var paramsObject = {};\ntry {\n  if (paramsJson && paramsJson.length) {\n    paramsObject = JSON.parse(paramsJson);\n  }\n} catch (_ignoredParse) {}\nif (paramsObject && paramsObject.limit !== undefined && paramsObject.limit !== null) {\n  limit = paramsObject.limit;\n}\n"
