        {
          "kind": "element",
          "tag": "expression",
          "children": [{
            "kind": "text",
            "text": "var Engine = Packages.com.twinsoft.convertigo.engine.Engine;\nvar feedbackMode = String(C8O.reporting.resolveMode());\nvar limitText = limit == null ? \"\" : String(limit).trim();\nvar maxLimit = 500;\nvar limitValue = 0;\nif (limitText.length > 0) {\n  try {\n    var parsedLimit = parseInt(limitText, 10);\n    if (!isNaN(parsedLimit)) {\n      limitValue = parsedLimit;\n    }\n  } catch (_ignoredLimit) {}\n}\nif (limitValue < 0) { limitValue = 0; }\nif (limitValue > maxLimit) { limitValue = maxLimit; }\n\nvar cursorRaw = \"\";\nif (typeof _nextCursor !== \"undefined\" && _nextCursor !== null) {\n  var cursorText = String(_nextCursor).trim();\n  if (cursorText.length && cursorText.toLowerCase() !== \"undefined\" && cursorText.indexOf(\"org.mozilla.javascript.Undefined\") !== 0) {\n    cursorRaw = cursorText;\n  }\n}\nvar startIndex = 0;\nif (cursorRaw.length > 0) {\n  try {\n    var parsedCursor = parseInt(cursorRaw, 10);\n    if (!isNaN(parsedCursor) && parsedCursor >= 0) {\n      startIndex = parsedCursor;\n    }\n  } catch (_ignoredCursor) {}\n}\n\nvar toolNames = [];\ntry {\n  var sequences = context.project.getSequencesList();\n  var iterator = sequences.iterator();\n  while (iterator.hasNext()) {\n    var seq = iterator.next();\n    if (!seq) { continue; }\n    try {\n      var seqName = seq.getName();\n      if (seqName && seqName.startsWith(\"tools_\")) {\n        if (feedbackMode == \"off\" && seqName == \"tools_report_create\") {\n          continue;\n        }\n        toolNames.push(seqName);\n      }\n    } catch (_ignoredName) {}\n  }\n} catch (_ignoredSequences) {}\n\nvar totalCount = toolNames.length;\nif (startIndex < 0) { startIndex = 0; }\nif (startIndex > totalCount) { startIndex = totalCount; }\nvar endIndex = limitValue > 0 ? Math.min(totalCount, startIndex + limitValue) : totalCount;\nvar windowList = toolNames.slice(startIndex, endIndex);\nvar hasMore = limitValue > 0 && endIndex < totalCount;\nvar nextCursorValue = hasMore ? String(endIndex) : \"\";\n\ntoolNamesWindow = windowList;\ntoolsTotalCount = totalCount;\ntoolsStartIndex = startIndex;\ntoolsLimitValue = limitValue;\ntoolsLimitOutput = limitValue > 0 ? limitValue : null;\ntoolsReturnedCount = windowList.length;\ntoolsCursorInput = cursorRaw;\ntoolsHasMore = hasMore;\ntoolsNextCursor = nextCursorValue;"
          }]
        }
