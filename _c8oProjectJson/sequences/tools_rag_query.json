            "text": "latencyMs = java.lang.System.currentTimeMillis() - startedAt;\nvar parsedStatus = 0;\nvar statusText = httpStatusText == null ? \"\" : String(httpStatusText).trim();\nif (statusText.length) {\n  try {\n    parsedStatus = parseInt(statusText, 10);\n  } catch (_ignoredStatus) {}\n}\nif (isNaN(parsedStatus)) {\n  parsedStatus = 0;\n}\nhttpStatusCode = parsedStatus;\nresultStatus = parsedStatus >= 200 && parsedStatus < 300 ? \"ok\" : \"error\";\nretryable = parsedStatus == 408 || parsedStatus == 429 || parsedStatus >= 500;\nresultMessage = (resultStatus == \"ok\"\n  ? \"Knowledge base answer received.\"\n  : \"Knowledge base request failed.\") + \" Typical response time: 30-60 seconds.\";\n\nvar refs = [];\nvar refsSource = referencesNodes;\nif (refsSource != null) {\n  try {\n    if (typeof refsSource.item === \"function\" && typeof refsSource.getLength === \"function\") {\n      for (var i = 0; i < refsSource.getLength(); i++) {\n        var refNode = refsSource.item(i);\n        var refText = \"\";\n        if (refNode != null) {\n          refText = typeof refNode.getTextContent === \"function\" ? String(refNode.getTextContent()) : String(refNode);\n        }\n        refText = refText == null ? \"\" : String(refText).trim();\n        if (refText.length) {\n          refs.push(refText);\n        }\n      }\n    } else if (typeof refsSource.length === \"number\") {\n      for (var j = 0; j < refsSource.length; j++) {\n        var refNodeAlt = refsSource[j];\n        var refTextAlt = \"\";\n        if (refNodeAlt != null) {\n          refTextAlt = typeof refNodeAlt.getTextContent === \"function\" ? String(refNodeAlt.getTextContent()) : String(refNodeAlt);\n        }\n        refTextAlt = refTextAlt == null ? \"\" : String(refTextAlt).trim();\n        if (refTextAlt.length) {\n          refs.push(refTextAlt);\n        }\n      }\n    } else {\n      var singleRef = String(refsSource).trim();\n      if (singleRef.length) {\n        refs.push(singleRef);\n      }\n    }\n  } catch (_ignoredRefs) {}\n}\nreferencesList = refs;"
