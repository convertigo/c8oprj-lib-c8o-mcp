      "children": [
        {
          "kind": "element",
          "tag": "comment",
          "children": [{
            "kind": "text",
            "text": "Resolve project and perform save"
          }]
        },
        {
          "kind": "element",
          "tag": "expression",
          "children": [{
            "kind": "text",
            "text": "var Engine = Packages.com.twinsoft.convertigo.engine.Engine;\n\nvar providedName = C8O.util.toTrimmedString(project);\nif (!providedName.length && context && context.project) {\n  providedName = String(context.project.getName());\n}\n\nvar projectRef = null;\nif (providedName.length) {\n  try {\n    projectRef = Engine.theApp.databaseObjectsManager.getOriginalProjectByName(providedName);\n  } catch (_ignoredLookup) {}\n}\nif (projectRef == null && context && context.project) {\n  projectRef = context.project;\n}\n\nvar resolvedName = projectRef != null ? String(projectRef.getName()) : providedName;\nvar errorEntries = [];\nvar saveResult = C8O.dbo.saveProject(projectRef, errorEntries);\n\nprojectSaveProvided = providedName;\nprojectSaveName = resolvedName;\nprojectSaveSaved = saveResult.saved === true;\nprojectSaveMessage = saveResult.message || \"\";\nprojectSaveTimestamp = java.lang.System.currentTimeMillis();\nprojectSaveErrors = errorEntries;\nprojectSaveStatus = projectSaveSaved ? \"saved\" : (projectRef == null ? \"missing\" : \"skipped\");\n"
          }]
        }
      ]
    },
