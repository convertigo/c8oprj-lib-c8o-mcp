      "bean": {
        "selector": "yaml_key",
        "raw": "InitContext [steps.SimpleStep-1772114900001]",
        "name": "InitContext",
        "className": "steps.SimpleStep",
        "priority": 1772114900001
      },
      "children": [
        {
          "kind": "element",
          "tag": "comment",
          "children": [{
            "kind": "text",
            "text": "Resolve project and optionally change auto-build state"
          }]
        },
        {
          "kind": "element",
          "tag": "expression",
          "children": [{
            "kind": "text",
            "text": "var Engine = Packages.com.twinsoft.convertigo.engine.Engine;\nvar providedProject = project == null ? \"\" : String(project).trim();\nif (!providedProject.length && context && context.project) {\n  providedProject = String(context.project.getName());\n}\nvar enabledText = enabled == null ? \"\" : String(enabled).trim();\n\nvar parseBoolean = function(text) {\n  var lower = String(text).trim().toLowerCase();\n  if (lower === \"true\" || lower === \"1\" || lower === \"yes\" || lower === \"on\") {\n    return true;\n  }\n  if (lower === \"false\" || lower === \"0\" || lower === \"no\" || lower === \"off\") {\n    return false;\n  }\n  throw new Error(\"Invalid boolean value for enabled: \" + text);\n};\n\nresultTimestamp = java.lang.System.currentTimeMillis();\nresultStudioMode = Engine.isStudioMode();\nresultProject = providedProject;\nresultHasRequestedEnabled = enabledText.length > 0;\nresultRequestedEnabled = false;\nresultPreviousEnabled = false;\nresultCurrentEnabled = false;\nresultChanged = false;\nresultStatus = \"error\";\nresultMessage = \"\";\nresultError = \"\";\n\ntry {\n  if (!resultStudioMode) {\n    resultStatus = \"skipped\";\n    resultMessage = \"Auto-build control skipped: Convertigo Studio required\";\n  } else {\n    if (!providedProject.length) {\n      throw new Error(\"Project name is required\");\n    }\n    var projectRef = Engine.theApp.databaseObjectsManager.getOriginalProjectByName(providedProject);\n    if (projectRef == null) {\n      throw new Error(\"Project not found: \" + providedProject);\n    }\n    var mobileBuilder = projectRef.getMobileBuilder();\n    if (mobileBuilder == null) {\n      throw new Error(\"Mobile builder unavailable for project: \" + providedProject);\n    }\n\n    var previousEnabled = mobileBuilder.isAutoBuild();\n    resultPreviousEnabled = previousEnabled;\n\n    if (enabledText.length > 0) {\n      var requestedEnabled = parseBoolean(enabledText);\n      resultRequestedEnabled = requestedEnabled;\n      if (previousEnabled !== requestedEnabled) {\n        mobileBuilder.setAutoBuild(requestedEnabled);\n        resultChanged = true;\n      }\n    }\n\n    resultCurrentEnabled = mobileBuilder.isAutoBuild();\n    resultStatus = \"ok\";\n    resultMessage = \"Auto-build is \" + (resultCurrentEnabled ? \"ON\" : \"OFF\");\n  }\n} catch (autobuildError) {\n  resultStatus = \"error\";\n  resultMessage = String(autobuildError);\n  resultError = String(autobuildError);\n}"
          }]
        }
      ]
    },
