        "kind": "text",
        "text": "Read\/set Studio mobile builder auto-build mode for a target project."
      }]
    },
    {
      "kind": "element",
      "tag": "bean",
      "attributes": [{
        "name": "yaml_key",
        "value": "InitContext [steps.SimpleStep-1772114900001]"
