{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://convertigo.com/schemas/review/mismatch-matrix.schema.json",
  "title": "Mismatch Matrix",
  "type": "object",
  "required": ["schemaVersion", "baselineServerVersion", "rows"],
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "baselineServerVersion": {
      "type": "string"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "source",
          "artifact",
          "statement",
          "liveStatus",
          "severity",
          "owner"
        ],
        "properties": {
          "id": { "type": "string" },
          "kind": {
            "type": "string",
            "enum": [
              "live-tool",
              "live-resource",
              "live-prompt",
              "repo-doc",
              "repo-prompt",
              "repo-test",
              "repo-index",
              "repo-catalog",
              "pattern-source"
            ]
          },
          "source": { "type": "string" },
          "artifact": { "type": "string" },
          "statement": { "type": "string" },
          "liveStatus": {
            "type": "string",
            "enum": [
              "matches-live",
              "obsolete",
              "planned-not-live",
              "pattern-only"
            ]
          },
          "replacement": { "type": "string" },
          "severity": {
            "type": "string",
            "enum": ["info", "low", "medium", "high", "critical"]
          },
          "owner": { "type": "string" },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
