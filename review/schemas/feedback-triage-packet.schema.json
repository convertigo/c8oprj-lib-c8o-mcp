{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://convertigo.local/schemas/feedback-triage-packet.schema.json",
  "title": "Convertigo MCP Feedback Triage Packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "batchId",
    "createdAt",
    "allowedDispositions",
    "summary",
    "sourceReports"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "batchId": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "allowedDispositions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "OPEN",
          "CLOSED_ALREADY_FIXED",
          "ROUTE_EXTERNAL",
          "SPLIT_REQUIRED",
          "DROP_NOISE"
        ]
      },
      "uniqueItems": true
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceReportCount",
        "byArea",
        "bySeverity",
        "byRepoHint"
      ],
      "properties": {
        "sourceReportCount": {
          "type": "integer",
          "minimum": 0
        },
        "byArea": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "bySeverity": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "byRepoHint": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "sourceReports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reportId",
          "sourcePath",
          "repoHint",
          "finding",
          "source",
          "evidencePaths"
        ],
        "properties": {
          "reportId": {
            "type": "string",
            "minLength": 1
          },
          "sourcePath": {
            "type": "string",
            "minLength": 1
          },
          "repoHint": {
            "type": "string",
            "enum": [
              "c8oprj-c8o-mcp",
              "codex-cli-multiagent",
              "unknown"
            ]
          },
          "finding": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "area",
              "subjectId",
              "severity",
              "summary"
            ],
            "properties": {
              "area": {
                "type": "string"
              },
              "subjectId": {
                "type": "string"
              },
              "severity": {
                "type": "string"
              },
              "summary": {
                "type": "string"
              },
              "evidence": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "suggestion": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "serverVersion",
              "projectVersion",
              "rolePrompt",
              "project",
              "runMode",
              "runId",
              "provider",
              "model"
            ],
            "properties": {
              "serverVersion": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "projectVersion": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "rolePrompt": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "project": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "runMode": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "runId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "provider": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "model": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "evidencePaths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
