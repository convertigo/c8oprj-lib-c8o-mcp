{
  "project": "GroupOutingsPoll",
  "starter": "ngx",
  "database": {
    "mode": "hsqldb",
    "connector": "appdb",
    "technology": "HSQLDB",
    "host": "localhost",
    "port": 9001,
    "database": "group_outings_poll",
    "user": "SA",
    "password": ""
  },
  "facade": {
    "prefix": "poll",
    "publicListSequence": "poll_list"
  },
  "relations": [
    {
      "name": "member_group",
      "type": "many-to-one",
      "fromEntity": "members",
      "fromField": "group_id",
      "toEntity": "groups",
      "toField": "id",
      "required": true,
      "label": "Group"
    },
    {
      "name": "outing_group",
      "type": "many-to-one",
      "fromEntity": "outings",
      "fromField": "group_id",
      "toEntity": "groups",
      "toField": "id",
      "required": true,
      "label": "Group"
    },
    {
      "name": "preference_member",
      "type": "many-to-one",
      "fromEntity": "preferences",
      "fromField": "member_id",
      "toEntity": "members",
      "toField": "id",
      "required": true,
      "label": "Member"
    },
    {
      "name": "preference_outing",
      "type": "many-to-one",
      "fromEntity": "preferences",
      "fromField": "outing_id",
      "toEntity": "outings",
      "toField": "id",
      "required": true,
      "label": "Outing"
    }
  ],
  "entities": [
    {
      "name": "groups",
      "label": "Groups",
      "fields": [
        { "name": "Id", "type": "INT", "primary": true },
        { "name": "Name", "type": "VARCHAR(128)", "unique": true },
        { "name": "City", "type": "VARCHAR(128)" }
      ]
    },
    {
      "name": "members",
      "label": "Members",
      "fields": [
        { "name": "Id", "type": "INT", "primary": true },
        { "name": "FirstName", "type": "VARCHAR(128)" },
        { "name": "LastName", "type": "VARCHAR(128)" },
        { "name": "Email", "type": "VARCHAR(255)", "unique": true },
        { "name": "GroupId", "column": "group_id", "type": "INT", "required": true, "references": { "entity": "groups", "field": "id" } }
      ],
      "ui": {
        "listFields": ["first_name", "last_name", "group_id"],
        "detailFields": ["first_name", "last_name", "email", "group_id"],
        "formFields": ["first_name", "last_name", "email", "group_id"],
        "fieldLabels": {
          "first_name": "First name",
          "last_name": "Last name",
          "group_id": "Group"
        },
        "relationFields": {
          "group_id": {
            "control": "select",
            "optionLabelField": "name",
            "optionValueField": "id",
            "placeholder": "Select group"
          }
        }
      }
    },
    {
      "name": "outings",
      "label": "Outings",
      "fields": [
        { "name": "Id", "type": "INT", "primary": true },
        { "name": "Title", "type": "VARCHAR(255)", "unique": true },
        { "name": "Category", "type": "VARCHAR(128)" },
        { "name": "PreferredDay", "column": "preferred_day", "type": "VARCHAR(64)" },
        { "name": "GroupId", "column": "group_id", "type": "INT", "required": true, "references": { "entity": "groups", "field": "id" } }
      ],
      "ui": {
        "listFields": ["title", "group_id"],
        "detailFields": ["title", "category", "preferred_day", "group_id"],
        "formFields": ["title", "category", "preferred_day", "group_id"],
        "fieldLabels": {
          "preferred_day": "Preferred day",
          "group_id": "Group"
        },
        "relationFields": {
          "group_id": {
            "control": "select",
            "optionLabelField": "name",
            "optionValueField": "id",
            "placeholder": "Select group"
          }
        }
      }
    },
    {
      "name": "preferences",
      "label": "Preferences",
      "fields": [
        { "name": "Id", "type": "INT", "primary": true },
        { "name": "MemberId", "column": "member_id", "type": "INT", "required": true, "references": { "entity": "members", "field": "id" } },
        { "name": "OutingId", "column": "outing_id", "type": "INT", "required": true, "references": { "entity": "outings", "field": "id" } },
        { "name": "Vote", "type": "VARCHAR(32)" },
        { "name": "Comment", "type": "VARCHAR(255)" }
      ],
      "ui": {
        "listFields": ["member_id", "outing_id", "vote"],
        "detailFields": ["member_id", "outing_id", "vote", "comment"],
        "formFields": ["member_id", "outing_id", "vote", "comment"],
        "fieldLabels": {
          "member_id": "Member",
          "outing_id": "Outing"
        },
        "relationFields": {
          "member_id": {
            "control": "select",
            "optionLabelField": "email",
            "optionValueField": "id",
            "placeholder": "Select member"
          },
          "outing_id": {
            "control": "select",
            "optionLabelField": "title",
            "optionValueField": "id",
            "placeholder": "Select outing"
          }
        }
      }
    }
  ],
  "seed": {
    "enabled": true,
    "rowsPerEntity": 8
  },
  "ui": {
    "entryPage": "Page",
    "variant": "entity-pages"
  }
}
